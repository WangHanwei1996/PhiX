{
    // Face-flux + Steinbach(Laplacian) + η-noise demo run.
    // Separate from settings.jsonc so the original is untouched.
    // (Adds constants.T which the solver reads; original only had T_start.)
    "mesh": { "nx": 256, "ny": 256, "dx": 6.0e-10, "dy": 6.0e-10, "x0": 0.0, "y0": 0.0 },

    "initialize": {
        "start_from": "initial_field",
        "dt": 5.0e-10,
        "nSteps": 200
    },

    "constants": {
        "T": 1100.0,
        "Vm_liq": 1.058e-5, "Vm_phi1": 9.77e-6, "Vm_phi2": 1.039e-5, "Vm_phi3": 1.164e-5,
        "T_g": 700.0, "alpha": 1.0, "p_SR": 0.28,
        "noise_mean": 0.0, "noise_std": 1.0e-3, "noise_seed": 42
    },

    "boundary_conditions": {
        "x_min": "Periodic", "x_max": "Periodic",
        "y_min": "Periodic", "y_max": "Periodic"
    },

    "output": {
        "print_interval": 25,
        "write_interval": 20,
        "format": "ALL",
        "coord_scale": 1.0
    }
}
