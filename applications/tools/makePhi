#!/usr/bin/env python3
"""
makePhi — PhiX solver scaffolding tool

Usage
-----
  makePhi           Scan .cu files in CWD, generate CMakeLists.txt and
                    register the directory in the PhiX root CMakeLists.txt.
                    Executables are placed in the source directory.

  makePhi clean     Remove the generated CMakeLists.txt and unregister from
                    the root CMakeLists.txt.

Notes
-----
  - The tool identifies its own generated CMakeLists.txt by a marker comment
    at the top.  It will refuse to overwrite a CMakeLists.txt that it did not
    create unless you delete it manually first.
  - Add $PHIX_DIR/applications/tools to PATH (or source etc/bashrc) to use
    makePhi from anywhere inside the project.
"""

import sys
import os
import re
import subprocess
from pathlib import Path

# ── marker written at the top of every generated CMakeLists.txt ─────────────
MARKER = "# [makePhi generated]"

# ────────────────────────────────────────────────────────────────────────────
# Helpers
# ────────────────────────────────────────────────────────────────────────────

def find_root(start: Path) -> Path:
    """Walk up the directory tree to find the PhiX root
    (the first ancestor that contains a CMakeLists.txt with 'project(PhiX')."""
    p = start.resolve()
    while p != p.parent:
        cml = p / "CMakeLists.txt"
        if cml.exists() and "project(PhiX" in cml.read_text(errors="replace"):
            return p
        p = p.parent
    raise RuntimeError(
        "Cannot find the PhiX root directory.\n"
        "Make sure you are inside a PhiX workspace and that its root\n"
        "CMakeLists.txt contains 'project(PhiX ...'."
    )


def make_local_cmake(cu_files: list) -> str:
    """Return the content of the CMakeLists.txt to be written in CWD."""
    lines = [MARKER + "\n"]
    for cu in cu_files:
        stem = cu.stem
        runtime_dir = "${CMAKE_CURRENT_SOURCE_DIR}"

        lines.append("\n")
        lines.append(f"add_executable({stem} {cu.name})\n")
        lines.append("\n")
        lines.append(f"target_link_libraries({stem} PRIVATE phix)\n")
        lines.append("\n")
        lines.append(f"set_target_properties({stem} PROPERTIES\n")
        lines.append(f"    CUDA_SEPARABLE_COMPILATION ON\n")
        lines.append(f'    RUNTIME_OUTPUT_DIRECTORY "{runtime_dir}"\n')
        lines.append(f")\n")

    return "".join(lines)


def insert_add_subdirectory(root_text: str, add_sub: str) -> str:
    """Append add_sub after the last add_subdirectory line (commented or not)
    in root_text.  Falls back to appending at end-of-file."""
    pat = re.compile(r"^\s*#?\s*add_subdirectory\s*\(", re.MULTILINE)
    lines = root_text.splitlines(keepends=True)
    last_idx = -1
    for i, line in enumerate(lines):
        if pat.match(line):
            last_idx = i
    if last_idx == -1:
        lines.append(add_sub + "\n")
    else:
        lines.insert(last_idx + 1, add_sub + "\n")
    return "".join(lines)


# ────────────────────────────────────────────────────────────────────────────
# Commands
# ────────────────────────────────────────────────────────────────────────────

def cmd_generate(cwd: Path) -> None:
    cu_files = sorted(cwd.glob("*.cu"))
    if not cu_files:
        _err(f"No .cu files found in {cwd}\n"
             f"Run makePhi from the directory that contains your solver source.")

    root = find_root(cwd)
    rel  = cwd.relative_to(root)

    # ── local CMakeLists.txt ─────────────────────────────────────────────────
    cml_path = cwd / "CMakeLists.txt"
    if cml_path.exists():
        if MARKER not in cml_path.read_text(errors="replace"):
            _err(
                f"{cml_path.relative_to(root)} already exists and was NOT\n"
                f"generated by makePhi.  Delete it manually first if you want\n"
                f"makePhi to manage it."
            )
        print(f"[makePhi] Regenerating  {cml_path.relative_to(root)}")
    else:
        print(f"[makePhi] Generating    {cml_path.relative_to(root)}")

    cml_path.write_text(make_local_cmake(cu_files))

    # ── root CMakeLists.txt ──────────────────────────────────────────────────
    root_cml  = root / "CMakeLists.txt"
    root_text = root_cml.read_text()
    add_sub   = f'add_subdirectory("{rel.as_posix()}")'

    # Collect all currently active (non-commented) add_subdirectory paths.
    _active_pat = re.compile(
        r'^add_subdirectory\s*\(\s*"?([^")\s]+)"?\s*\)', re.MULTILINE)
    active_dirs = {m.group(1) for m in _active_pat.finditer(root_text)}

    # Check whether any ancestor of cwd is already registered — if so,
    # cwd is already included transitively and adding it again would cause
    # a duplicate binary-directory error in CMake.
    parts = rel.parts
    ancestor_registered = next(
        (("/".join(parts[:d])) for d in range(1, len(parts))
         if "/".join(parts[:d]) in active_dirs),
        None,
    )

    if ancestor_registered:
        print(f"[makePhi] Skipping root registration: already included via\n"
              f"          {ancestor_registered}")
    elif add_sub in root_text:
        print(f"[makePhi] Already registered: {add_sub}")
    else:
        # Uncomment if a commented-out version exists; otherwise insert fresh.
        commented = f"# {add_sub}"
        if commented in root_text:
            root_text = root_text.replace(commented, add_sub, 1)
            print(f"[makePhi] Uncommented in root CMakeLists.txt: {add_sub}")
        else:
            root_text = insert_add_subdirectory(root_text, add_sub)
            print(f"[makePhi] Added to root CMakeLists.txt:\n"
                  f"          {add_sub}")
        root_cml.write_text(root_text)

    targets = " ".join(cu.stem for cu in cu_files)

    # ── build ────────────────────────────────────────────────────────────────
    build_dir = root / "build"
    if not build_dir.is_dir():
        print(f"[makePhi] No build/ directory found at {build_dir}\n"
              f"          Run: mkdir -p {build_dir} && cd {build_dir} && cmake ..")
        return

    # cmake configure (always re-run so the new add_subdirectory is picked up)
    print(f"\n[makePhi] Configuring... (cmake {root})")
    r = subprocess.run(["cmake", str(root)], cwd=build_dir)
    if r.returncode != 0:
        _err("cmake configuration failed.")

    # build only the new targets
    nproc = os.cpu_count() or 1
    target_list = targets.split()
    print(f"\n[makePhi] Building: {targets}")
    r = subprocess.run(["make", f"-j{nproc}"] + target_list, cwd=build_dir)
    if r.returncode != 0:
        _err("make failed.")

    print(f"\n[makePhi] Done.  Executables written to:\n"
          f"    {cwd}/\n"
          f"\n[makePhi] To use them by name from any directory:\n"
          f"    source {root}/etc/bashrc")


def cmd_clean(cwd: Path) -> None:
    root = find_root(cwd)
    rel  = cwd.relative_to(root)

    # ── local CMakeLists.txt ─────────────────────────────────────────────────
    cml_path = cwd / "CMakeLists.txt"
    if cml_path.exists():
        if MARKER in cml_path.read_text(errors="replace"):
            cml_path.unlink()
            print(f"[makePhi] Removed  {cml_path.relative_to(root)}")
        else:
            print(f"[makePhi] Skipped  {cml_path.relative_to(root)}"
                  f"  (not generated by makePhi)")
    else:
        print(f"[makePhi] No CMakeLists.txt found in {cwd}")

    # ── root CMakeLists.txt ──────────────────────────────────────────────────
    root_cml  = root / "CMakeLists.txt"
    root_text = root_cml.read_text()
    add_sub   = f'add_subdirectory("{rel.as_posix()}")'

    # Strip the line (with optional trailing newline)
    new_text = re.sub(
        r"^" + re.escape(add_sub) + r"\r?\n?",
        "",
        root_text,
        flags=re.MULTILINE,
    )
    if new_text != root_text:
        root_cml.write_text(new_text)
        print(f"[makePhi] Removed from root CMakeLists.txt:\n"
              f"          {add_sub}")
    else:
        print(f"[makePhi] Not found in root CMakeLists.txt:\n"
              f"          {add_sub}")

    print("\n[makePhi] Clean done.  (case/ directories were left untouched.)")


# ────────────────────────────────────────────────────────────────────────────
# Entry point
# ────────────────────────────────────────────────────────────────────────────

def _err(msg: str) -> None:
    print(f"[makePhi] Error: {msg}", file=sys.stderr)
    sys.exit(1)


def main() -> None:
    args = sys.argv[1:]
    cwd  = Path.cwd()

    try:
        if not args:
            cmd_generate(cwd)
        elif args[0] == "clean":
            cmd_clean(cwd)
        else:
            print(__doc__)
            sys.exit(1)
    except RuntimeError as exc:
        _err(str(exc))


if __name__ == "__main__":
    main()
