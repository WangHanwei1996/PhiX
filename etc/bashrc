# ===========================================================================
# PhiX environment setup
#
# Usage (add to ~/.bashrc or source manually):
#   source /path/to/PhiX/etc/bashrc
#
# Sets:
#   PHIX_DIR   — project root (auto-detected from this file's location)
#   PATH       — all directories anywhere under $PHIX_DIR (excluding build/)
#                that contain at least one executable are prepended
# ===========================================================================

# ---------------------------------------------------------------------------
# Locate project root (one level above this file)
# ---------------------------------------------------------------------------
export PHIX_DIR
PHIX_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# ---------------------------------------------------------------------------
# Collect unique parent directories of executables anywhere in the project
# (excluding build/) and prepend them to PATH.
# ---------------------------------------------------------------------------
_phix_setup_path() {
    local added=""

    while IFS= read -r exe; do
        local dir
        dir="$(dirname "$exe")"

        # skip if already queued this iteration or already in PATH
        case ":${added}:${PATH}:" in
            *":${dir}:"*) continue ;;
        esac

        added="${added:+${added}:}${dir}"
    done < <(find "$PHIX_DIR" \
                -path "$PHIX_DIR/build" -prune -o \
                -type f -executable -print 2>/dev/null | sort)

    if [ -n "$added" ]; then
        export PATH="${added}:${PATH}"
    fi
}

_phix_setup_path
unset -f _phix_setup_path

# ---------------------------------------------------------------------------
# whw — Workspace Hub Waypoint: jump to PhiX project root
# ---------------------------------------------------------------------------
whw() {
    cd "$PHIX_DIR" || return
}

# ---------------------------------------------------------------------------
# app — jump to applications directory
# ---------------------------------------------------------------------------
app() {
    cd "$PHIX_DIR/applications" || return
}

# ---------------------------------------------------------------------------
# develop — jump to develop directory
# ---------------------------------------------------------------------------
develop() {
    cd "$PHIX_DIR/develop" || return
}

# ---------------------------------------------------------------------------
# solver — manage solvers
#   solver -list   list all compiled solver executables
# ---------------------------------------------------------------------------
solver() {
    case "$1" in
        -list)
            find "$PHIX_DIR/applications/solvers" \
                -type f -executable \
                ! -name "*.*" \
                -printf "%f\n" | sort
            ;;
        *)
            echo "Usage: solver -list"
            ;;
    esac
}

echo "PhiX sourced: PHIX_DIR=$PHIX_DIR"

echo -e "\033[32mWelcome to the PhiX Suite! 🚀\033[0m"

# ---------------------------------------------------------------------------
# makePhi — wrapper that calls the Python implementation then re-sources
#           this file so new executables immediately enter PATH
# ---------------------------------------------------------------------------
makePhi() {
    python3 "$PHIX_DIR/applications/tools/_makePhi" "$@"
    local _exit=$?
    # Re-source to pick up any newly compiled executables
    # shellcheck source=/dev/null
    source "$PHIX_DIR/etc/bashrc"
    return $_exit
}

# ===========================================================================
# PhiX developer commands (v2.26.0) — OpenFOAM-style helpers.
# The tools in applications/tools/ (phixInfo, phixPlot, phixMonitor,
# phixClean, phixNewCase) are picked up by the PATH scan above.
# ===========================================================================

# ---------------------------------------------------------------------------
# phixBuild [make-targets...] — configure (if needed) and build in
# $PHIX_DIR/build.  Fresh configures pass the nvcc path and architecture
# explicitly (empty CUDAARCHS in the environment otherwise breaks CMake).
# ---------------------------------------------------------------------------
phixBuild() {
    local bdir="$PHIX_DIR/build"
    if [ ! -f "$bdir/CMakeCache.txt" ]; then
        mkdir -p "$bdir"
        cmake -S "$PHIX_DIR" -B "$bdir" \
              -DCMAKE_CUDA_COMPILER=/usr/local/cuda/bin/nvcc \
              -DCMAKE_CUDA_ARCHITECTURES="${PHIX_CUDA_ARCH:-75}" \
              -DPHIX_CUDA_ARCH="${PHIX_CUDA_ARCH:-75}" || return
    fi
    cmake --build "$bdir" -j "$(nproc)" ${1:+--target "$@"}
}

# ---------------------------------------------------------------------------
# phixTest [ctest-args...] — run the test suite (e.g. phixTest -R module_kks)
# ---------------------------------------------------------------------------
phixTest() {
    ctest --test-dir "$PHIX_DIR/build" --output-on-failure "$@"
}

# ---------------------------------------------------------------------------
# phixBench — run the performance baselines
# ---------------------------------------------------------------------------
phixBench() {
    "$PHIX_DIR/build/test/benchmark/bench_stencil" &&
    "$PHIX_DIR/build/test/benchmark/bench_semiimplicit"
}

# ---------------------------------------------------------------------------
# phixVersion [-a] — newest release (or all), from changelog/
# ---------------------------------------------------------------------------
phixVersion() {
    local d
    if [ "${1:-}" = "-a" ]; then
        for d in $(ls -d "$PHIX_DIR"/changelog/v* | sort -V); do
            printf '%-10s %s\n' "$(basename "$d")" \
                "$(head -1 "$d/RELEASE.md" | sed 's/^# *//')"
        done
    else
        d=$(ls -d "$PHIX_DIR"/changelog/v* | sort -V | tail -1)
        head -1 "$d/RELEASE.md" | sed 's/^# *//'
    fi
}

# ---------------------------------------------------------------------------
# phixCase — jump to a solver's directory by name (phixCase GFA_FeB)
# ---------------------------------------------------------------------------
phixCase() {
    [ -n "${1:-}" ] || { echo "usage: phixCase <solverName>"; return 1; }
    local hit
    hit=$(find "$PHIX_DIR/applications/solvers" "$PHIX_DIR/develop" \
               -maxdepth 3 -type d -name "$1" 2>/dev/null | head -1)
    [ -n "$hit" ] && cd "$hit" || echo "phixCase: '$1' not found"
}
